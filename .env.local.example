# SKYWEE environment configuration for Casper Testnet
# Copy this file to .env.local and fill in your actual values.
# (.env.local is gitignored — never commit real secrets.)
#
# Verified live deploy on 2026-07-07. All 5 contracts are registered on-chain.
# See contracts.deployed.json for full deploy details (gas, hashes, attempts).

# === Network ===
CASPER_NETWORK=testnet
CASPER_RPC_URL=https://node.testnet.cspr.cloud/rpc
CASPER_NETWORK_NAME=casper-test
CASPER_CHAIN_NAME=casper-test

# === CSPR.cloud auth (required for testnet/mainnet since mid-2026) ===
# Get a free token at https://cspr.cloud → Account → API Tokens
CSPR_CLOUD_AUTH_TOKEN=your_cspr_cloud_bearer_token_here

# === Contract package hashes (LIVE on Casper testnet, verified 2026-07-07) ===
# All 5 contracts successfully deployed and registered on-chain.
# Source: contracts.deployed.json (cross-verified via cspr.live public API).
CONTRACT_AGENT_REGISTRY=hash-8ddaf7548dfc4505aed7a62a3d4c3fa4936ab8797771988cc6d560eed99b3ded
CONTRACT_INSURANCE=hash-b4d195a93712eb2f801549901756b1accb899b8f76d27bff57162ffec3d92b06
CONTRACT_TREASURY=hash-45e1049d82b95dd82119c7462f2d90a4bbf5f1978e3336cf6ba3437f7540bcee
CONTRACT_RWA_VAULT=hash-4898c97682442a9929e36b735cd645f42aa489540f07e9061f117e3f4cc50b21
CONTRACT_CARBON_GUARD=hash-3cbe0c274dd0728cf626c26aad333647b657d6ab0548aef983688271fffed63f

# === Deployer account (for reference only — DO NOT put secret key here) ===
# Public key: 0203220e30622aee8574de059922f3d9422c73d84b8372b5926f5e3e1e84277feb43
# Account hash: c1aa5031607fcc07a3c91f175ffd4f44c3238a11ce82905ecf6d236d777a0b20
# Secret key path on deploy machine: ~/casper-key/Skywee_secret_key.pem
# NEVER commit the actual secret key file. It's already gitignored by *.pem pattern.

# === Database ===
DATABASE_URL=file:./db/custom.db

# === Optional: CSPR.cloud analytics API key (for richer UI data) ===
# CSPR_CLOUD_API_KEY=your_cspr_cloud_api_key

# === Optional: MCP server URL (for agent integrations) ===
# CASPER_MCP_SERVER_URL=http://localhost:3001

# =============================================================================
# Quick start:
#   1. cp .env.local.example .env.local
#   2. Edit .env.local — fill in CSPR_CLOUD_AUTH_TOKEN (get free at cspr.cloud)
#   3. bun install   (first time only)
#   4. bun run dev
#   5. Open http://localhost:3000
#
# To verify contracts are reachable:
#   curl -s -X POST https://node.testnet.cspr.cloud/rpc \
#     -H "Authorization: Bearer $CSPR_CLOUD_AUTH_TOKEN" \
#     -H "Content-Type: application/json" \
#     --data '{"jsonrpc":"2.0","method":"query_global_state",
#              "params":{"state_identifier":{"StateRootHash":"latest"},
#                        "key":"hash-8ddaf7548dfc4505aed7a62a3d4c3fa4936ab8797771988cc6d560eed99b3ded",
#                        "path":[]},"id":1}' | jq
# =============================================================================
